	hierarchy 'Date Jerarquía'
		lineageTag: fc37af17-ab2e-4ab8-bb84-d8b2296857f3

		level Date
			lineageTag: f6d40b7f-2288-49f5-a598-839e71d5fd56
			column: Date

	partition Calendario = calculated
		mode: import
		source = ```
				
				    ADDCOLUMNS (
				        CALENDAR(FIRSTDATE(Reservaciones[Check-in]),LASTDATE(Reservaciones[Check-in])), // Crea el rango de fechas automático
				        "Año", YEAR ( [Date] ),
				        "Mes", MONTH ( [Date] ),
				        "Trimestre", QUARTER ( [Date] ),
				        "Nombre Mes", FORMAT ( [Date], "mmm" ), // Muestra el nombre completo del mes
				        "Día del Mes", DAY ( [Date] ),
				        "N° Semana",WEEKNUM([Date])
				    )
				```

	annotation PBI_Id = 14960f629231436a9e957a08bffb3ce5

